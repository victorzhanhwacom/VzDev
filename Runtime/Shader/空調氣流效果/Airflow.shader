// VzDev/DCIM/Airflow
// Data center airflow effect - URP / WebGL friendly, SRP Batcher compatible, texture-free, additive.
// Mesh generated by AirflowTube.cs:
//   uv0.x = 0..1 along path, uv0.y = 0..1 around circumference
//   uv1.x = arc length in meters
//   tangent.xyz / uv2.xyz = cross-section frame (side / up) used for sway
Shader "VzDev/DCIM/Airflow"
{
    Properties
    {
        [Header(Color)]
        [HDR] _ColorStart ("Start Color (Supply)", Color) = (0.25, 0.85, 1.6, 1)
        [HDR] _ColorEnd   ("End Color", Color) = (0.25, 0.85, 1.6, 1)
        _Intensity ("Intensity", Range(0, 4)) = 1
        _GradientStart ("Gradient Start (0-1 along path)", Range(0, 1)) = 0
        _GradientEnd   ("Gradient End (0-1 along path)", Range(0, 1)) = 1
        _GradientNoise ("Gradient Edge Breakup", Range(0, 0.3)) = 0.08

        [Header(Flow)]
        _Speed           ("Speed (m/s)", Float) = 1.2
        _Density         ("Streaks per Meter", Float) = 0.8
        _StreakLength    ("Streak Length", Range(0.05, 0.95)) = 0.45
        _StreakSharpness ("Streak Tail Falloff", Range(1, 6)) = 2.5
        _SpeedJitter     ("Lane Speed Variance", Range(0, 1)) = 0.35
        _BrightJitter    ("Streak Brightness Variance", Range(0, 1)) = 0.6

        [Header(Shape)]
        _Lanes     ("Lanes (integer)", Float) = 10
        _LineWidth ("Line Width", Range(0.05, 0.6)) = 0.3
        _BodyGlow  ("Volume Glow", Range(0, 0.5)) = 0.04
        _EdgePower ("Edge Softness", Range(0.5, 6)) = 2
        _EndFade   ("End Fade", Range(0.01, 0.5)) = 0.12

        [Header(Turbulence)]
        _SwayAmp    ("Sway Amplitude (m)", Range(0, 0.5)) = 0.08
        _SwayFreq   ("Sway Frequency (per m)", Float) = 0.8
        _SwaySpeed  ("Sway Speed", Float) = 1.5
        _Twist      ("Twist (turns per m)", Range(-1, 1)) = 0.12
        _WiggleAmp  ("Streak Wiggle (keep + LineWidth/2 < 0.5)", Range(0, 0.35)) = 0.2
        _WiggleFreq ("Streak Wiggle Frequency", Float) = 2.5
    }

    SubShader
    {
        Tags
        {
            "RenderPipeline" = "UniversalPipeline"
            "RenderType" = "Transparent"
            "Queue" = "Transparent"
            "IgnoreProjector" = "True"
        }

        Pass
        {
            Name "Airflow"
            Tags { "LightMode" = "UniversalForward" }

            Blend One One
            ZWrite Off
            ZTest LEqual
            Cull Back
            ColorMask RGB

            HLSLPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            CBUFFER_START(UnityPerMaterial)
                half4 _ColorStart;
                half4 _ColorEnd;
                half  _Intensity;
                half  _GradientStart;
                half  _GradientEnd;
                half  _GradientNoise;
                float _Speed;
                float _Density;
                half  _StreakLength;
                half  _StreakSharpness;
                half  _SpeedJitter;
                half  _BrightJitter;
                float _Lanes;
                half  _LineWidth;
                half  _BodyGlow;
                half  _EdgePower;
                half  _EndFade;
                float _SwayAmp;
                float _SwayFreq;
                float _SwaySpeed;
                float _Twist;
                half  _WiggleAmp;
                float _WiggleFreq;
            CBUFFER_END

            // Global time set by AirflowTube.cs (wrapped to keep float precision on 24/7 displays)
            float _AirflowTime;

            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float4 tangentOS  : TANGENT;    // frame side vector
                float2 uv0        : TEXCOORD0;
                float2 uv1        : TEXCOORD1;
                float3 uv2        : TEXCOORD2;  // frame up vector
                half4  color      : COLOR;      // rgb = tint, a = airflow intensity
            };

            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float3 flow       : TEXCOORD0;  // x = arc (m), y = around (+twist), z = 0..1 along path
                half4  color      : TEXCOORD1;
            };

            Varyings vert (Attributes v)
            {
                Varyings o;
                float t   = v.uv0.x;
                float arc = v.uv1.x;
                float tt  = _AirflowTime;

                // Low-frequency 3D sway: fixed at outlet, grows downstream
                float k  = arc * _SwayFreq;
                float ts = tt * _SwaySpeed;
                float sx = sin(k - ts) + 0.5 * sin(k * 2.3 - ts * 1.7 + 1.3);
                float sy = cos(k * 1.6 - ts * 1.2 + 0.7) + 0.4 * sin(k * 3.1 - ts * 2.1 + 2.1);
                float grow = smoothstep(0.0, 0.3, t) * (0.4 + t);
                float3 offsetOS = (v.tangentOS.xyz * sx + v.uv2 * sy) * (_SwayAmp * grow);

                float3 positionWS = TransformObjectToWorld(v.positionOS.xyz + offsetOS);
                o.positionCS = TransformWorldToHClip(positionWS);

                float3 nWS = TransformObjectToWorldNormal(v.normalOS);
                float3 vWS = normalize(GetCameraPositionWS() - positionWS);
                half edge = pow(saturate(abs(dot(nWS, vWS))), _EdgePower);

                half ends = smoothstep(0.0h, _EndFade, (half)t) * smoothstep(0.0h, _EndFade, 1.0h - (half)t);
                // Color gradient is evaluated per pixel in frag (avoids per-vertex banding)
                o.color = half4(v.color.rgb, edge * ends * v.color.a * _Intensity);

                // Helical twist: streaks spiral slowly around the tube
                o.flow = float3(arc, v.uv0.y + arc * _Twist, t);
                return o;
            }

            half4 frag (Varyings i) : SV_Target
            {
                float laneF  = i.flow.y * _Lanes;
                float lane   = floor(laneF);
                half  across = frac(laneF);

                half h1 = frac(lane * 0.6180339887);
                half h2 = frac(lane * 0.7548776662 + 0.31);

                // Each lane meanders sideways independently (float args: time can be large)
                float wArg = i.flow.x * _WiggleFreq * (0.7 + 0.6 * h2) - _AirflowTime * _SwaySpeed * 1.3 + h1 * 6.2831853;
                half  wig  = (half)sin(wArg) * _WiggleAmp;
                half  lineMask = saturate(1.0h - abs(across - 0.5h - wig) * 2.0h / _LineWidth);
                lineMask *= lineMask;

                float speed = _Speed * (1.0 + (h2 - 0.5) * _SpeedJitter);
                float phase = (i.flow.x - _AirflowTime * speed) * _Density + h1;
                half  f = frac(phase);
                half  streak = saturate((f - (1.0h - _StreakLength)) / _StreakLength);
                streak = pow(streak, _StreakSharpness);
                streak *= saturate((1.0h - f) * 25.0h);

                // Per-streak brightness variation
                half b = frac(floor(phase) * 0.6180339887 + h2 * 0.5);
                streak *= lerp(1.0h, b, _BrightJitter);

                // Per-pixel gradient with organic, drifting boundary (integer ring frequencies keep the seam continuous)
                float ringA = i.flow.y * 12.5663706;   // 2 turns
                float ringB = i.flow.y * 18.8495559;   // 3 turns
                half edgeN = (half)(sin(ringA + i.flow.x * 1.7 - _AirflowTime * 0.8) * 0.6
                                  + sin(ringB - i.flow.x * 2.3 + _AirflowTime * 0.6) * 0.4);
                half range = max(_GradientEnd - _GradientStart, 0.001h);
                half g = saturate(((half)i.flow.z + edgeN * _GradientNoise - _GradientStart) / range);
                g = g * g * g * (g * (g * 6.0h - 15.0h) + 10.0h);   // smootherstep: no visible start/end kink
                half3 grad = lerp(_ColorStart.rgb, _ColorEnd.rgb, g);

                half v = streak * lineMask + _BodyGlow;
                half3 col = grad * i.color.rgb * (v * i.color.a);

                // Screen-space dither to kill 8-bit banding in dark soft gradients (WebGL)
                float2 sp = i.positionCS.xy;
                half ign = (half)frac(52.9829189 * frac(dot(sp, float2(0.06711056, 0.00583715))));
                half lum = max(col.r, max(col.g, col.b));
                col += (ign - 0.5h) * (1.0h / 255.0h) * saturate(lum * 16.0h);

                return half4(max(col, 0.0h), 0);
            }
            ENDHLSL
        }
    }
    FallBack Off
}
